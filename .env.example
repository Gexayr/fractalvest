# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=fractionalvest
POSTGRES_USER=fvuser
POSTGRES_PASSWORD=change-this-password

# ── API ─────────────────────────────────────────────────────────────────────
# JWT signing secret — must be long and random in production
SESSION_SECRET=change-this-secret-min-32-chars

# Google OAuth client ID — from https://console.cloud.google.com/
# Used by both the API server (to verify tokens) and the web build (VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Pino log level: trace | debug | info | warn | error
LOG_LEVEL=info

# ── NOWPayments (crypto deposits) ────────────────────────────────────────────
# API key from https://account.nowpayments.io/settings (Payments tab)
NOWPAYMENTS_API_KEY=
# IPN secret key, generated in the same settings page — used to verify webhook signatures
NOWPAYMENTS_IPN_SECRET_KEY=
# Use the sandbox API (https://sandbox.nowpayments.io) instead of production
NOWPAYMENTS_SANDBOX=false
# Publicly reachable base URL of this app, used to build the NOWPayments
# IPN callback and success/cancel redirect URLs (e.g. https://app.example.com).
# Must be reachable from the internet — use a tunnel (e.g. ngrok) in local dev.
APP_BASE_URL=

# ── Ports ────────────────────────────────────────────────────────────────────
# Host port the web frontend is exposed on (default: 80)
APP_PORT=80
# Internal port the API server listens on (default: 8080)
API_PORT=8080
# Host port PostgreSQL is exposed on (default: 54321)
DB_PORT=54321
